# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server logs
.next-dev.log
.next-dev.err.log

# Local reports may contain private screenshots and authenticated browser state.
# Ignore does NOT exclude files from a local Next build or deployment upload;
# public/reports is served as static content if included in a deployed public/ tree.
/public/reports/
/paper_rewriting_output/

# Browser automation outputs and local caches (preserve existing files on disk).
/playwright-report/
/test-results/
/.playwright/
/.cache/
/edge-profile/
/edge-*-profile/
/playwright-profile*/
/browser-profile*/

# Raw copyrighted source PDFs and OCR intermediates; no publication rights implied.
/raw/

# Local PDF extraction output must remain private and untracked.
/cet-extracted/

# Local release evidence, writing work, and generated Python caches.
/docs.zip
/writing-output/
/writing-prompts/
/supabase/migrations/0007_seed_cet_real_exam_review.sql
/docs/cet-0007-internal-trial-audit-*.md
**/__pycache__/
*.pyc
